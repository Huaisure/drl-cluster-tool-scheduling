{
  "_meta": {
    "name": "mixed_3pm_20w",
    "description": "10 route-A wafers and 10 route-B wafers share a three-PM serial flow"
  },
  "Modules": {
    "LP": {"type": "LP"},
    "PM1": {"type": "PM"},
    "PM2": {"type": "PM"},
    "PM3": {"type": "PM"}
  },
  "ClusterTool": {
    "TM1": {
      "module_ids": ["LP", "PM1", "PM2", "PM3"],
      "arm_type": "single_arm",
      "travel_times": 1,
      "pick_time": 1,
      "place_time": 1
    }
  },
  "routes": {
    "A": [
      {"module_id": "PM1", "process_time": 4},
      {"module_id": "PM2", "process_time": 6},
      {"module_id": "PM3", "process_time": 5}
    ],
    "B": [
      {"module_id": "PM2", "process_time": 3},
      {"module_id": "PM3", "process_time": 8}
    ]
  },
  "initial_state": {
    "robots": {
      "TM1": {"position_module_id": "LP"}
    },
    "wafers": [
      {
        "route_id": "A",
        "wafer_index": "0-9",
        "step_index": 0,
        "location": {"kind": "module", "module_id": "LP"}
      },
      {
        "route_id": "B",
        "wafer_index": "0-9",
        "step_index": 0,
        "location": {"kind": "module", "module_id": "LP"}
      }
    ]
  }
}
